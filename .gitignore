# Package managers.
node_modules/
# Runtime Composer dependencies are tracked for Push-to-Deploy.
# Refresh them with `composer install --no-dev --no-scripts`.
.cursor

# Lock file intentionally excluded to allow easier testing against multiple php versions
# This follows the precedent put forth by the WordPress core {@link https://github.com/WordPress/wordpress-develop/commit/0e442c4615bdcdc1c2e4f8db6f88f57e6859c2ff}
composer.lock

# Ignore built files
/readme.txt
# Production CSS and JS are tracked because Push-to-Deploy does not run npm.
blocks/certificate-title/*
blocks/my-account/*
blocks/pricing-table/*
blocks/access-plan-button/*
blocks/checkout/*
blocks/course-author/*
blocks/course-continue/*
blocks/course-meta-info/*
blocks/course-outline/*
blocks/course-prerequisites/*
blocks/course-reviews/*
blocks/course-syllabus/*
blocks/courses/*
blocks/login/*
blocks/memberships/*
blocks/my-achievements/*
blocks/navigation-link/*
blocks/registration/*

languages/lifterlms.pot

# Bundled libraries: ignore built artifacts and per-library node_modules only.
/libraries/**/node_modules/
/libraries/lifterlms-blocks/i18n/
/libraries/lifterlms-rest/web_deploy/

# Exclude maps.
/blocks/**/*.js.map
/assets/css/*.map
/assets/js/*.map
/assets/maps/*

# Misc.
*.log
.DS_Store

# Release distribution directory.
/dist/
/tmp/

# Non-distributable configs.
phpunit.xml
.llmsenv

# Playwright / E2E test artifacts.
/artifacts/
/playwright-report/
/test-results/
